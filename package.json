{
  "name": "baron3x3-lokalny-montazysta",
  "version": "0.1.0",
  "private": true,
  "description": "Lokalny pipeline montażu rolek Baron3x3",
  "scripts": {
    "library:organize": ".venv/bin/python scripts/library_organize.py",
    "assets:scan": ".venv/bin/python scripts/asset_catalog.py",
    "assets:search": ".venv/bin/python scripts/asset_catalog.py --search",
    "broll:plan": ".venv/bin/python scripts/broll_planner.py",
    "broll:apply": ".venv/bin/python scripts/broll_planner.py --apply",
    "director:prepare": ".venv/bin/python scripts/beat_director.py prepare",
    "director:reference": ".venv/bin/python scripts/beat_director.py reference",
    "director:target": ".venv/bin/python scripts/beat_director.py target",
    "director:plan": ".venv/bin/python scripts/beat_director.py plan",
    "director:import-cline": "/usr/bin/python3 scripts/beat_director.py import-cline",
    "director:apply": ".venv/bin/python scripts/beat_director.py apply",
    "director:status": ".venv/bin/python scripts/beat_director.py status",
    "eval:prepare": ".venv/bin/python scripts/model_eval.py prepare",
    "eval:run": ".venv/bin/python scripts/model_eval.py run",
    "eval:status": ".venv/bin/python scripts/model_eval.py status",
    "qa:preview": ".venv/bin/python scripts/preview_qa.py",
    "qa:attention": ".venv/bin/python scripts/attention_map.py",
    "qa:semantic:prepare": ".venv/bin/python scripts/semantic_preview_qa.py",
    "qa:semantic:import": ".venv/bin/python scripts/semantic_preview_qa.py --import-cline",
    "stock:search": ".venv/bin/python scripts/stock_library.py search",
    "stock:download": ".venv/bin/python scripts/stock_library.py download",
    "stock:status": ".venv/bin/python scripts/stock_library.py status",
    "style:validate": ".venv/bin/python scripts/style_memory.py validate",
    "style:status": ".venv/bin/python scripts/style_memory.py status",
    "style:snapshot": ".venv/bin/python scripts/style_memory.py snapshot",
    "style:record": ".venv/bin/python scripts/style_memory.py record",
    "reel:start": ".venv/bin/python scripts/reel_workflow.py start",
    "reel:validate-story": ".venv/bin/python scripts/reel_workflow.py validate-story",
    "reel:approve-story": ".venv/bin/python scripts/reel_workflow.py approve-story",
    "reel:import-director": ".venv/bin/python scripts/reel_workflow.py import-director",
    "reel:approve-director": ".venv/bin/python scripts/reel_workflow.py approve-director",
    "reel:render": ".venv/bin/python scripts/reel_workflow.py render",
    "reel:status": ".venv/bin/python scripts/reel_workflow.py status",
    "check": "tsc --noEmit && remotion versions",
    "frames": ".venv-vision/bin/python scripts/review_frames.py",
    "pipeline": ".venv/bin/python scripts/pipeline.py",
    "remotion": "remotion",
    "studio": "remotion studio remotion/src/index.ts --no-open",
    "test:api": ".venv/bin/python -m unittest discover -s tests -v",
    "test:api:live": ".venv/bin/python scripts/openrouter_smoke.py",
    "test:video:live": "python3 scripts/openrouter_video_smoke.py",
    "stage9": ".venv/bin/python scripts/stage9.py",
    "test:remotion": "remotion render remotion/src/index.ts RemotionSmokeTest output/remotion-smoke.mp4 --log=verbose",
    "test:effects": "remotion render remotion/src/index.ts BaronEffectsShowcase output/effects-smoke.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-bitrate=256k --overwrite",
    "test:broll": "remotion render remotion/src/index.ts BaronBrollShowcase output/broll-treatment-smoke.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --overwrite",
    "test:editorial": "remotion render remotion/src/index.ts BaronEditorialShowcase output/editorial-composition-smoke.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --overwrite",
    "photos:prepare": ".venv/bin/python scripts/matte_photos.py",
    "reel:refresh-scenario": ".venv/bin/python scripts/reel_workflow.py refresh-scenario",
    "reel:revise-director": ".venv/bin/python scripts/reel_workflow.py revise-director",
    "reel:specialist": ".venv/bin/python -m scripts.specialists",
    "resolve:mcp:server": ".venv-resolve/bin/python davinci_mcp/server.py",
    "resolve:mcp:test": ".venv/bin/python -m unittest discover -s davinci_mcp/tests -v",
    "resolve:mcp:opencode": ".venv/bin/python davinci_mcp/launch.py",
    "baron": ".venv-studio/bin/python scripts/baron_studio.py",
    "check:studio": "tsc --project tsconfig.studio.json --noEmit",
    "test:studio": ".venv-studio/bin/python -m unittest discover -s tests/studio -v",
    "studio:preview": "remotion studio remotion/studio/index.tsx --no-open"
  },
  "dependencies": {
    "@remotion/captions": "4.0.518",
    "@remotion/cli": "4.0.518",
    "@remotion/effects": "4.0.518",
    "@remotion/media": "4.0.518",
    "d3-geo": "^3.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.518",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "24.10.10",
    "@types/react": "19.2.14",
    "@types/topojson-client": "^3.1.5",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
