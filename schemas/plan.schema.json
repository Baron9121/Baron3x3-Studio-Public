{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "fps": {
      "const": 30
    },
    "width": {
      "const": 1080
    },
    "height": {
      "const": 1920
    },
    "aroll": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "source",
        "sha256",
        "duration"
      ]
    },
    "elements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^Z[0-9]{2,}$"
              },
              "type": {
                "const": "zoom"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "scale_from": {
                "type": "number",
                "minimum": 1,
                "maximum": 1.5
              },
              "scale_to": {
                "type": "number",
                "minimum": 1,
                "maximum": 1.5
              }
            },
            "required": [
              "id",
              "type",
              "start",
              "end",
              "scale_from",
              "scale_to"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^B[0-9]{2,}$"
              },
              "type": {
                "const": "broll"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_start": {
                "type": "number",
                "minimum": 0
              },
              "kind": {
                "enum": [
                  "video",
                  "image"
                ]
              },
              "scale_from": {
                "type": "number",
                "minimum": 1,
                "maximum": 1.5
              },
              "scale_to": {
                "type": "number",
                "minimum": 1,
                "maximum": 1.5
              }
            },
            "required": [
              "id",
              "type",
              "start",
              "end",
              "source",
              "kind"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^C[0-9]{2,}$"
              },
              "type": {
                "const": "caption"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "words": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end": {
                      "type": "number",
                      "minimum": 0
                    },
                    "confidence": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "highlight": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "text",
                    "start",
                    "end"
                  ]
                }
              }
            },
            "required": [
              "id",
              "type",
              "start",
              "end",
              "words"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^P[0-9]{2,}$"
              },
              "type": {
                "const": "photo"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "photos": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "face": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "contain": {
                      "type": "boolean"
                    },
                    "zoom": {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 1.3
                    }
                  },
                  "required": [
                    "source"
                  ]
                }
              },
              "sfx": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "type",
              "start",
              "end",
              "photos"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^G[0-9]{2,}$"
              },
              "type": {
                "const": "graphic"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "variant": {
                "enum": [
                  "counter",
                  "globe"
                ]
              },
              "data": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "type",
              "start",
              "end",
              "variant",
              "data"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^M[0-9]{2,}$"
              },
              "type": {
                "const": "music"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_start": {
                "type": "number",
                "minimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "fade_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              }
            },
            "required": [
              "id",
              "type",
              "start",
              "end",
              "source",
              "volume"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^S[0-9]{2,}$"
              },
              "type": {
                "const": "sfx"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_start": {
                "type": "number",
                "minimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "fade_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              }
            },
            "required": [
              "id",
              "type",
              "start",
              "end",
              "source",
              "volume"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "project",
    "fps",
    "width",
    "height",
    "aroll",
    "elements"
  ]
}
